//Aqui conterá o formulário de entrada (E-mail e Senha).

<div style="max-width: 1100px; margin: 0 auto; padding: 20px; font-family: system-ui, sans-serif;">
  <!-- Cabeçalho -->
  <header style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 40px;">
    <h1 style="font-size: 28px; margin: 0;">
      <a href="/" style="text-decoration: none; color: inherit;">🍏 Health Sync</a>
    </h1>
    <div>
      <a href="/register" style="padding: 10px 20px; background: #000; color: white; text-decoration: none; border-radius: 8px;">
        Criar Conta
      </a>
    </div>
  </header>

  <!-- Área do Formulário de Login -->
  <div style="max-width: 400px; margin: 0 auto; padding: 40px 0; text-align: center;">
    <h2 style="font-size: 32px; margin-bottom: 8px;">Bem-vindo de volta!</h2>
    <p style="color: #555; margin-bottom: 32px;">Acesse sua conta para continuar 🌿</p>

    <form action="/login" method="POST" style="text-align: left;">
      <label style="display: block; margin-bottom: 8px; font-weight: 500; font-size: 14px;">E-mail</label>
      <input type="email" name="email" placeholder="exemplo@email.com" required 
             style="width: 100%; padding: 12px; margin-bottom: 20px; border: 1px solid #ddd; border-radius: 8px; font-size: 16px; font-family: inherit; box-sizing: border-box;">

      <label style="display: block; margin-bottom: 8px; font-weight: 500; font-size: 14px;">Senha</label>
      <input type="password" name="password" placeholder="••••••••" required 
             style="width: 100%; padding: 12px; margin-bottom: 24px; border: 1px solid #ddd; border-radius: 8px; font-size: 16px; font-family: inherit; box-sizing: border-box;">

      <button type="submit" style="width: 100%; padding: 14px; background: #000; color: white; border: none; border-radius: 8px; font-size: 16px; cursor: pointer; font-weight: bold; font-family: inherit;">
        Entrar
      </button>
    </form>

    <p style="margin-top: 24px; color: #666; font-size: 15px;">
      Ainda não tem uma conta? <a href="/register" style="color: #000; font-weight: 600; text-decoration: none;">Registre-se aqui</a>
    </p>
  </div>
</div>